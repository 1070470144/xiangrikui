static func description(id: String) -> String:
	match id:
		"sun_arrow": return "夜晚自动发射阳矢攻击敌人。\n后续强化射击、灼烧与范围伤害。"
		"root_heart": return "生命上限＋60，立即回血60，减伤5%；夜晚每秒回血0.4。\n后续强化恢复，并治疗附近植物。"
		"dawn_pulse": return "夜晚释放范围脉冲，伤害并短暂眩晕普通怪和精英。\n后续强化眩晕、范围与释放频率。"
	var data := preload("res://scripts/content_data.gd").get_mother_upgrade(id)
	var values: Array = EFFECTS.get(str(data.get("branch", "")), [])
	var index := int(data.get("rank", 0)) - 1
	return str(values[index]) if index >= 0 and index < values.size() else ""
