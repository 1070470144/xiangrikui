config_version=5

[application]

config/name="最后的向日葵：原型"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

PlantResources="*res://scripts/plant_resource_cache.gd"

[display]

